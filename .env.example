# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Audiobookshelf Configuration
# The URL of your Audiobookshelf instance (e.g., https://audiobookshelf.example.com)
ABS_URL=""
# Your Audiobookshelf API Token
ABS_TOKEN=""
# Optional: Extra headers in JSON format (e.g. for Cloudflare Access)
# Example: {"CF-Access-Client-Id": "id", "CF-Access-Client-Secret": "secret"}
ABS_EXTRA_HEADERS=""

# Persistent Cache Configuration
# Path to SQLite database file (default: ./data/shelflife.db or /app/data/shelflife.db in Docker)
DB_PATH="./data/shelflife.db"
# Sync interval in seconds (default: 300 = 5 minutes)
SYNC_INTERVAL=300
